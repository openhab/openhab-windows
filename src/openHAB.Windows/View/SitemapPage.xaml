<Page x:Class="openHAB.Windows.View.SitemapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      mc:Ignorable="d"
      DataContext="{x:Bind ViewModel}">
    <Grid x:Name="MainContentGrid"
          Margin="35,0,0,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Orientation="Vertical"
                    Margin="12,0,0,10">
            <TextBlock VerticalAlignment="Center"
                       FontSize="42"
                       Text="{Binding Label, Mode=OneWay}"
                       Tapped="SitemapTextBlock_Tapped" />
            <BreadcrumbBar Margin="0,0,0,10"
                           ItemsSource="{Binding BreadcrumbItems, Mode=OneWay}"
                           ItemClicked="BreadcrumbBar_ItemClicked">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate>
                        <BreadcrumbBarItem Content="{Binding}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="21"
                                               Text="{Binding Label}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <GridView x:Name="MasterListView"
                      Margin="12,0,0,0"
                      IsItemClickEnabled="True"
                      IsTapEnabled="True"
                      ItemClick="MasterListView_OnItemClick"
                      ItemTemplateSelector="{StaticResource WidgetTemplateSelector}"
                      ItemsSource="{Binding CurrentWidgets, Mode=OneWay}"
                      SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel Orientation="Horizontal"
                                            VerticalSpacing="10"
                                            HorizontalSpacing="10" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>
